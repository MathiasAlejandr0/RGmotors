# RG Motors — variables de entorno (copiar a .env.local)
# No commitear secretos reales.

# --- Obligatorias en producción Vercel ---
ADMIN_SESSION_SECRET=
CRON_SECRET=

# Vercel KV / Upstash Redis (obligatorio en VERCEL_ENV=production)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — fotos y frames 360 durables + CDN
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=https://rg-motors.vercel.app

# --- Opcionales ---
# NEXT_PUBLIC_BASE_PATH=/RGmotors
# GITHUB_PAGES=true
# ALLOW_DEFAULT_ADMIN_USER=1

# --- Futuro (sin contrato WebPay aún) ---
# RESEND_API_KEY=
# EMAIL_FROM=noreply@rgmotorschile.cl
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# WEBPAY_ENVIRONMENT=integration
